---
import { getCollection, render } from 'astro:content';
import DailyLayout from '../../layouts/DailyLayout.astro';
import DetailLayout from '../../layouts/DetailLayout.astro';

export async function getStaticPaths() {
  const dailyEntries = await getCollection('daily', ({ data }) => !data.draft);
  return Promise.all(dailyEntries.map(async entry => {
    const { Content } = await render(entry);
    return {
      params: { slug: entry.slug },
      props: {
        title: entry.data.title,
        description: entry.data.description,
        pubDate: entry.data.pubDate,
        source: entry.data.source,
        fullImage: entry.data.fullImage || undefined,
        Content,
      },
    };
  }));
}

const { title, description, pubDate, source, fullImage, Content } = Astro.props;
---

{fullImage ? (
  <DetailLayout title={title} description={description} fullImage={fullImage} />
) : (
  <DailyLayout title={title} description={description} pubDate={pubDate} source={source}>
    <Content />
  </DailyLayout>
)}

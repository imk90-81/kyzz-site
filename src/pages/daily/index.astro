---
import { ViewTransitions } from 'astro:transitions';
import '../../styles/global.css';
import Search from '../../components/Search.astro';
import { getCollection } from 'astro:content';

const dailyEntries = (await getCollection('daily', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const reportEntries = (await getCollection('reports', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const vibecodingEntries = (await getCollection('vibecoding', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

// 侧边栏栏目总数（完整集合，非切片）
const blogCount = (await getCollection('blog', ({ data }) => !data.draft).catch(() => [])).length;
const reportCount = (await getCollection('reports', ({ data }) => !data.draft).catch(() => [])).length;
const vibecodingCount = (await getCollection('vibecoding', ({ data }) => !data.draft).catch(() => [])).length;

const formatDate = (date: Date) => {
  return date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Daily | Kyzz空间站</title>
    <meta name="description" content="AI Coding 领域每日精选，值得关注的动态与洞察" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <ViewTransitions />
  </head>
  <body>
    <div class="home-container">
      <!-- 左侧个人信息区 -->
      <aside class="sidebar">
        <div class="sidebar-content">
          <img class="avatar" src="/images/avatar.jpg" alt="头像" />
          <h1 class="site-name">Kyzz空间站</h1>
          <p class="site-tagline"><span id="live-clock" class="live-clock">--</span></p>

          <nav class="nav-section">
            <div class="nav-title">导航</div>
            <a href="/" class="nav-item">
              <span class="nav-icon">🏠</span>
              <span class="nav-label">首页</span>
            </a>
            <a href="/blog" class="nav-item">
              <span class="nav-icon">📝</span>
              <span class="nav-label">博客</span>
              <span class="nav-count">{blogPosts.length}</span>
            </a>
            <a href="/daily" class="nav-item active">
              <span class="nav-icon">📰</span>
              <span class="nav-label">Daily</span>
              <span class="nav-count">{dailyEntries.length}</span>
            </a>
            <a href="/reports" class="nav-item">
              <span class="nav-icon">📊</span>
              <span class="nav-label">Reports</span>
              <span class="nav-count">{reportEntries.length}</span>
            </a>
            <a href="/vibecoding" class="nav-item">
              <span class="nav-icon">⚡</span>
              <span class="nav-label">VibeCoding</span>
              <span class="nav-count">{vibecodingCount}</span>
            </a>
            <button id="search-trigger" class="nav-item">
              <span class="nav-icon">🔍</span>
              <span class="nav-label">搜索</span>
            </button>
          </nav>

          <div class="theme-switcher">
            <button class="theme-btn active" data-theme="cosmos" title="宇宙">🌌</button>
            <button class="theme-btn" data-theme="day" title="白昼">☀️</button>
            <button class="theme-btn" data-theme="nebula" title="星云">🌠</button>
          </div>

          <div class="social-links">
            <a href="mailto:imkyzz@163.com" class="social-link" title="邮箱">📧</a>
            <a href="https://github.com/kyzzwon" target="_blank" class="social-link" title="GitHub">🐙</a>
          </div>
        </div>
      </aside>

      <!-- 右侧内容区 -->
      <main class="list-main-content">
        <div class="list-container">
          <!-- Page Header -->
          <div class="page-header">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-cyber-500 animate-pulse"></span>
              <span class="text-xs font-mono tracking-widest text-zinc-500 uppercase">Daily Digest</span>
            </div>
            <h1 class="page-title">每日动态</h1>
            <p class="page-desc">AI Coding 领域每日精选，值得关注的动态与洞察</p>
          </div>

          <!-- Card List -->
          <div class="daily-list">
            {dailyEntries.map(entry => (
              <a href={`/daily/${entry.slug}/`} class="daily-card">
                <div class="daily-card-top">
                  <span class="daily-card-date">{formatDate(entry.data.pubDate)}</span>
                  <span class="daily-card-badge">DAILY</span>
                </div>
                <h3 class="daily-card-title">{entry.data.title}</h3>
                <p class="daily-card-desc">{entry.data.description}</p>
                {entry.data.tags && entry.data.tags.length > 0 && (
                  <div class="daily-card-tags">
                    {entry.data.tags.slice(0, 5).map(tag => (
                      <span class="daily-card-tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>

          <!-- Empty State -->
          {dailyEntries.length === 0 && (
            <div class="empty-state">
              <p>暂无动态</p>
              <p class="empty-sub">敬请期待...</p>
            </div>
          )}
        </div>
      </main>
    </div>

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body {
        height: 100%;
        overflow: hidden;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }

      .home-container {
        display: grid;
        grid-template-columns: 260px 1fr;
        height: 100vh;
      }

      /* ===== 左侧 ===== */
      .sidebar {
        background: var(--color-surface);
        border-right: 1px solid var(--color-border);
        height: 100vh;
        overflow-y: auto;
      }

      .sidebar-content {
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 auto 14px;
        box-shadow: 0 0 24px rgba(0, 229, 255, 0.2);
      }

      .site-name {
        font-size: 18px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 4px;
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .site-tagline {
        font-size: 12px;
        color: var(--color-text-secondary);
        text-align: center;
        margin-bottom: 20px;
      }
      .live-clock {
        font-family: 'JetBrains Mono', 'Courier New', monospace;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.3px;
        white-space: nowrap;
      }

      .nav-section { margin-bottom: 16px; }

      .nav-title {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--color-text-secondary);
        margin-bottom: 8px;
        padding-left: 10px;
        opacity: 0.6;
      }

      .nav-item {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        border-radius: 8px;
        margin-bottom: 2px;
        cursor: pointer;
        transition: all 0.2s;
        color: var(--color-text-secondary);
        text-decoration: none;
        border: none;
        background: none;
        width: 100%;
        font-size: 13px;
        font-family: inherit;
      }

      .nav-item:hover { background: var(--color-border); color: var(--color-text); }

      .nav-item.active {
        background: linear-gradient(135deg, rgba(0, 229, 255, 0.08), rgba(99, 102, 241, 0.08));
        color: var(--color-accent);
      }

      .nav-icon { width: 18px; margin-right: 10px; font-size: 15px; }
      .nav-label { flex: 1; }

      .nav-count {
        font-size: 10px;
        background: var(--color-border);
        padding: 1px 7px;
        border-radius: 10px;
        color: var(--color-text-secondary);
      }

      .theme-switcher {
        display: flex;
        gap: 4px;
        padding: 6px;
        background: var(--color-border);
        border-radius: 8px;
        margin-top: auto;
      }

      .theme-btn {
        flex: 1;
        padding: 7px 4px;
        border-radius: 6px;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 16px;
      }

      .theme-btn:hover { background: rgba(255, 255, 255, 0.05); }

      .theme-btn.active {
        background: linear-gradient(135deg, rgba(0, 229, 255, 0.12), rgba(99, 102, 241, 0.12));
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.15);
      }

      .social-links {
        display: flex;
        gap: 8px;
        justify-content: center;
        padding-top: 14px;
        margin-top: 14px;
        border-top: 1px solid var(--color-border);
      }

      .social-link {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        background: var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s;
      }

      .social-link:hover { background: var(--color-accent); transform: translateY(-2px); }

      /* ===== 右侧列表内容 ===== */
      .list-main-content {
        overflow-y: auto;
        height: 100vh;
        background: var(--color-bg);
      }

      .list-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 32px 40px 60px;
      }

      .page-header {
        margin-bottom: 32px;
      }

      .page-title {
        font-size: 28px;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 8px;
      }

      .page-desc {
        font-size: 14px;
        color: var(--color-text-secondary);
      }

      .flex {
        display: flex;
      }

      .items-center {
        align-items: center;
      }

      .gap-3 {
        gap: 12px;
      }

      .mb-4 {
        margin-bottom: 16px;
      }

      .rounded-full {
        border-radius: 9999px;
      }

      .bg-cyber-500 {
        background-color: #00e5ff;
      }

      .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
      }

      .w-1\.5 {
        width: 6px;
      }

      .h-1\.5 {
        height: 6px;
      }

      .text-xs {
        font-size: 12px;
      }

      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }

      .tracking-widest {
        letter-spacing: 0.1em;
      }

      .text-zinc-500 {
        color: #71717a;
      }

      .uppercase {
        text-transform: uppercase;
      }

      /* ===== Daily Card List ===== */
      .daily-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
      }

      .daily-card {
        display: block;
        padding: 20px;
        border-radius: 12px;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        text-decoration: none;
        transition: all 0.3s;
      }

      .daily-card:hover {
        border-color: var(--color-accent);
        background: var(--color-surface-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 229, 255, 0.1);
      }

      .daily-card-top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }

      .daily-card-date {
        font-size: 12px;
        font-family: 'JetBrains Mono', monospace;
        color: var(--color-text-secondary);
      }

      .daily-card-badge {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        padding: 2px 8px;
        border-radius: 4px;
        background: rgba(0, 229, 255, 0.1);
        border: 1px solid rgba(0, 229, 255, 0.2);
        color: #00e5ff;
      }

      .daily-card-title {
        font-size: 18px;
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: 8px;
        line-height: 1.4;
      }

      .daily-card-desc {
        font-size: 14px;
        color: var(--color-text-secondary);
        line-height: 1.6;
        margin-bottom: 12px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      .daily-card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }

      .daily-card-tag {
        font-size: 11px;
        font-family: 'JetBrains Mono', monospace;
        padding: 2px 8px;
        border-radius: 9999px;
        background: rgba(0, 229, 255, 0.05);
        border: 1px solid rgba(0, 229, 255, 0.15);
        color: rgba(0, 229, 255, 0.7);
      }

      .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--color-text-secondary);
      }

      .empty-sub {
        font-size: 14px;
        margin-top: 8px;
      }

      /* ===== 响应式 ===== */
      @media (max-width: 900px) {
        .home-container {
          grid-template-columns: 1fr;
        }

        .sidebar {
          display: none;
        }

        .list-container {
          padding: 24px 20px 60px;
        }
      }
    </style>

    <script is:inline>
      (function() {
        var weekMap = ['日', '一', '二', '三', '四', '五', '六'];
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function formatNow() {
          var d = new Date();
          return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate())
            + ' 星期' + weekMap[d.getDay()]
            + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        }
        function startClock() {
          var el = document.getElementById('live-clock');
          if (!el) return;
          el.textContent = formatNow();
          if (el._timer) clearInterval(el._timer);
          el._timer = setInterval(function() { el.textContent = formatNow(); }, 1000);
        }

        function init() {
          startClock();

          // 主题切换
          document.querySelectorAll('.theme-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
              var theme = this.getAttribute('data-theme') || 'cosmos';
              document.querySelectorAll('.theme-btn').forEach(function(b) { b.classList.remove('active'); });
              this.classList.add('active');

              if (theme === 'cosmos') {
                document.documentElement.removeAttribute('data-theme');
              } else {
                document.documentElement.setAttribute('data-theme', theme);
              }
              try { localStorage.setItem('theme', theme); } catch (e) {}
            });
          });

          // 初始化主题
          try {
            var saved = localStorage.getItem('theme') || 'cosmos';
            var btn = document.querySelector('.theme-btn[data-theme="' + saved + '"]');
            if (btn) {
              document.querySelectorAll('.theme-btn').forEach(function(b) { b.classList.remove('active'); });
              btn.classList.add('active');
            }
          } catch (e) {}

          // 搜索
          document.getElementById('search-trigger')?.addEventListener('click', function() {
            var event = new KeyboardEvent('keydown', { key: 'k', ctrlKey: true });
            document.dispatchEvent(event);
          });
        }

        init();

        // ViewTransitions: 页面切换后重新初始化
        document.addEventListener('astro:page-load', function() {
          init();
        });
      })();
    </script>
    <Search />
  </body>
</html>

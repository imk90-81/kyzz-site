---
import { getCollection, render } from 'astro:content';
import DetailLayout from '../../layouts/DetailLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('vibecoding', ({ data }) => !data.draft);
  return Promise.all(entries.map(async entry => {
    const { Content } = await render(entry);
    return {
      params: { slug: entry.slug },
      props: {
        title: entry.data.title,
        description: entry.data.description,
        pubDate: entry.data.pubDate,
        fullImage: entry.data.fullImage || undefined,
        Content,
      },
    };
  }));
}

const { title, description, pubDate, fullImage, Content } = Astro.props;
---

{fullImage ? (
  <DetailLayout title={title} description={description} fullImage={fullImage} />
) : (
  <DetailLayout title={title} description={description} pubDate={pubDate}>
    <Content />
  </DetailLayout>
)}
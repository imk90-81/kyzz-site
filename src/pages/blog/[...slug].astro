---
import { getCollection } from 'astro:content';
import fs from 'fs';
import path from 'path';
import PostHtmlLayout from '../../layouts/PostHtmlLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft).catch(() => []));

  const paths = await Promise.all(posts.map(async (post) => {
    let htmlContent = '';
    try {
      const htmlPath = path.join(process.cwd(), 'public', 'blog', `${post.slug}.html`);
      const fullHtml = fs.readFileSync(htmlPath, 'utf-8');
      const bodyMatch = fullHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
      htmlContent = bodyMatch ? bodyMatch[1].trim() : fullHtml.trim();
    } catch (e) {
      console.error(`[Blog] Failed to read HTML for ${post.slug}:`, e instanceof Error ? e.message : String(e));
    }

    return {
      params: { slug: post.slug },
      props: { post, htmlContent },
    };
  }));

  return paths;
}

const { post, htmlContent } = Astro.props;
const { title, description, pubDate, tags = [], heroImage } = post.data;
---

<PostHtmlLayout
  title={title}
  description={description}
  pubDate={pubDate}
  tags={tags}
  heroImage={heroImage}
  htmlContent={htmlContent}
  slug={post.slug}
>
  {!htmlContent && <p class="text-zinc-400 text-center py-8">文章内容加载失败</p>}
</PostHtmlLayout>

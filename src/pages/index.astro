---
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Search from '../components/Search.astro';
import { getCollection } from 'astro:content';

const dailyEntries = (await getCollection('daily', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const reportEntries = (await getCollection('reports', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft).catch(() => []))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);

const formatDate = (date: Date) => {
  return date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
};

// 生成基于标题的渐变色
const gradients = [
  'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
  'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
  'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
  'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
  'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
  'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
  'linear-gradient(135deg, #fccb90 0%, #d57eeb 100%)',
  'linear-gradient(135deg, #e0c3fc 0%, #8ec5fc 100%)',
];

function getGradient(index: number): string {
  return gradients[index % gradients.length];
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kyzz空间站</title>
    <meta name="description" content="Kyzz空间站 - 在技术宇宙中漂浮的前哨站" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <ViewTransitions />
  </head>
  <body>
    <div class="home-container">
      <!-- 左侧个人信息区 -->
      <aside class="sidebar">
        <div class="sidebar-content">
          <img class="avatar" src="/images/avatar.jpg" alt="头像" />
          <h1 class="site-name">Kyzz空间站</h1>
          <p class="site-tagline">记录思考 · 分享成长</p>

          <nav class="nav-section">
            <div class="nav-title">导航</div>
            <a href="/" class="nav-item active">
              <span class="nav-icon">🏠</span>
              <span class="nav-label">首页</span>
            </a>
            <a href="/blog" class="nav-item">
              <span class="nav-icon">📝</span>
              <span class="nav-label">博客</span>
              <span class="nav-count">{blogPosts.length}</span>
            </a>
            <a href="/daily" class="nav-item">
              <span class="nav-icon">📰</span>
              <span class="nav-label">Daily</span>
              <span class="nav-count">{dailyEntries.length}</span>
            </a>
            <a href="/reports" class="nav-item">
              <span class="nav-icon">📊</span>
              <span class="nav-label">Reports</span>
              <span class="nav-count">{reportEntries.length}</span>
            </a>
            <button id="search-trigger" class="nav-item">
              <span class="nav-icon">🔍</span>
              <span class="nav-label">搜索</span>
            </button>
          </nav>

          <div class="theme-switcher">
            <button class="theme-btn active" data-theme="cosmos" title="宇宙">🌌</button>
            <button class="theme-btn" data-theme="day" title="白昼">☀️</button>
            <button class="theme-btn" data-theme="nebula" title="星云">🌠</button>
          </div>

          <div class="social-links">
            <a href="mailto:imkyzz@163.com" class="social-link" title="邮箱">📧</a>
            <a href="https://github.com/kyzzwon" target="_blank" class="social-link" title="GitHub">🐙</a>
          </div>
        </div>
      </aside>

      <!-- 右侧内容区 - 横向滚动 -->
      <main class="main-content" id="mainContent">
        <!-- Daily 栏目 -->
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-icon daily-icon">📰</span>
              Daily · 每日动态
            </h2>
            <a href="/daily" class="view-all">全部 →</a>
          </div>
          <div class="cards-list">
            {dailyEntries.map((entry, i) => (
              <a href={`/daily/${entry.slug}/`} class="card">
                <div class="card-image" style={`background: ${getGradient(i)};`}>
                  <div class="card-pattern"></div>
                  <div class="card-image-label">
                    <span class="card-image-date">{formatDate(entry.data.pubDate)}</span>
                    <span class="card-image-type">DAILY</span>
                  </div>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{entry.data.title}</h3>
                  <p class="card-desc">{entry.data.description}</p>
                  {entry.data.tags && entry.data.tags.length > 0 && (
                    <div class="card-tags">
                      {entry.data.tags.slice(0, 3).map(tag => (
                        <span class="card-tag-inline">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- Reports 栏目 -->
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-icon reports-icon">📊</span>
              Reports · 深度报告
            </h2>
            <a href="/reports" class="view-all">全部 →</a>
          </div>
          <div class="cards-list">
            {reportEntries.map((entry, i) => (
              <a href={`/reports/${entry.slug}/`} class="card">
                <div class="card-image" style={`background: ${getGradient(i + 3)};`}>
                  <div class="card-pattern"></div>
                  <div class="card-image-label">
                    <span class="card-image-date">{formatDate(entry.data.pubDate)}</span>
                    <span class="card-image-type">REPORT</span>
                  </div>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{entry.data.title}</h3>
                  <p class="card-desc">{entry.data.description}</p>
                  {entry.data.tags && entry.data.tags.length > 0 && (
                    <div class="card-tags">
                      {entry.data.tags.slice(0, 3).map(tag => (
                        <span class="card-tag-inline">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>

        <!-- Blog 栏目 -->
        <section class="section">
          <div class="section-header">
            <h2 class="section-title">
              <span class="section-icon blog-icon">💡</span>
              Blog · 博客文章
            </h2>
            <a href="/blog" class="view-all">全部 →</a>
          </div>
          <div class="cards-list">
            {blogPosts.map((post, i) => (
              <a href={`/blog/${post.slug}/`} class="card">
                <div class="card-image" style={`background: ${getGradient(i + 6)};`}>
                  <div class="card-pattern"></div>
                  <div class="card-image-label">
                    <span class="card-image-date">{formatDate(post.data.pubDate)}</span>
                    <span class="card-image-type">BLOG</span>
                  </div>
                </div>
                <div class="card-body">
                  <h3 class="card-title">{post.data.title}</h3>
                  <p class="card-desc">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="card-tags">
                      {post.data.tags.slice(0, 3).map(tag => (
                        <span class="card-tag-inline">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            ))}
          </div>
        </section>
      </main>
    </div>

    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      html, body {
        height: 100%;
        overflow: hidden;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
      }

      .home-container {
        display: grid;
        grid-template-columns: 260px 1fr;
        height: 100vh;
      }

      /* ===== 左侧 ===== */
      .sidebar {
        background: var(--color-surface);
        border-right: 1px solid var(--color-border);
        height: 100vh;
        overflow-y: auto;
      }

      .sidebar-content {
        padding: 28px 20px;
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .avatar {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        object-fit: cover;
        margin: 0 auto 14px;
        box-shadow: 0 0 24px rgba(0, 229, 255, 0.2);
      }

      .site-name {
        font-size: 18px;
        font-weight: 700;
        text-align: center;
        margin-bottom: 4px;
        background: linear-gradient(135deg, var(--color-accent), var(--color-accent-secondary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .site-tagline {
        font-size: 12px;
        color: var(--color-text-secondary);
        text-align: center;
        margin-bottom: 20px;
      }

      .nav-section { margin-bottom: 16px; }

      .nav-title {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--color-text-secondary);
        margin-bottom: 8px;
        padding-left: 10px;
        opacity: 0.6;
      }

      .nav-item {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        border-radius: 8px;
        margin-bottom: 2px;
        cursor: pointer;
        transition: all 0.2s;
        color: var(--color-text-secondary);
        text-decoration: none;
        border: none;
        background: none;
        width: 100%;
        font-size: 13px;
        font-family: inherit;
      }

      .nav-item:hover { background: var(--color-border); color: var(--color-text); }

      .nav-item.active {
        background: linear-gradient(135deg, rgba(0, 229, 255, 0.08), rgba(99, 102, 241, 0.08));
        color: var(--color-accent);
      }

      .nav-icon { width: 18px; margin-right: 10px; font-size: 15px; }
      .nav-label { flex: 1; }

      .nav-count {
        font-size: 10px;
        background: var(--color-border);
        padding: 1px 7px;
        border-radius: 10px;
        color: var(--color-text-secondary);
      }

      /* ===== 主题切换 ===== */
      .theme-switcher {
        display: flex;
        gap: 4px;
        padding: 6px;
        background: var(--color-border);
        border-radius: 8px;
        margin-top: auto;
      }

      .theme-btn {
        flex: 1;
        padding: 7px 4px;
        border-radius: 6px;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 16px;
      }

      .theme-btn:hover { background: rgba(255, 255, 255, 0.05); }

      .theme-btn.active {
        background: linear-gradient(135deg, rgba(0, 229, 255, 0.12), rgba(99, 102, 241, 0.12));
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.15);
      }

      /* ===== 社交链接 ===== */
      .social-links {
        display: flex;
        gap: 8px;
        justify-content: center;
        padding-top: 14px;
        margin-top: 14px;
        border-top: 1px solid var(--color-border);
      }

      .social-link {
        width: 30px;
        height: 30px;
        border-radius: 6px;
        background: var(--color-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        text-decoration: none;
        transition: all 0.2s;
      }

      .social-link:hover { background: var(--color-accent); transform: translateY(-2px); }

      /* ===== 右侧横向滚动 ===== */
      .main-content {
        display: flex;
        flex-direction: row;
        overflow-x: auto;
        overflow-y: hidden;
        scroll-snap-type: x mandatory;
        height: 100vh;
        padding: 24px 24px 24px 24px;
        gap: 24px;
      }

      .main-content::-webkit-scrollbar { height: 6px; }
      .main-content::-webkit-scrollbar-track { background: transparent; }
      .main-content::-webkit-scrollbar-thumb {
        background: var(--color-border);
        border-radius: 3px;
      }
      .main-content::-webkit-scrollbar-thumb:hover { background: var(--color-accent); }

      /* ===== 栏目区块 ===== */
      .section {
        min-width: 320px;
        max-width: 360px;
        height: calc(100vh - 48px);
        display: flex;
        flex-direction: column;
        scroll-snap-align: start;
        flex-shrink: 0;
      }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
        flex-shrink: 0;
      }

      .section-title {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-text);
        display: flex;
        align-items: center;
        gap: 8px;
      }

      .section-icon { font-size: 16px; }

      .view-all {
        font-size: 12px;
        color: var(--color-text-secondary);
        text-decoration: none;
        transition: color 0.2s;
        white-space: nowrap;
      }

      .view-all:hover { color: var(--color-accent); }

      /* ===== 卡片列表 ===== */
      .cards-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        overflow-y: auto;
        flex: 1;
        padding-right: 6px;
      }

      .cards-list::-webkit-scrollbar { width: 3px; }
      .cards-list::-webkit-scrollbar-track { background: transparent; }
      .cards-list::-webkit-scrollbar-thumb {
        background: var(--color-border);
        border-radius: 2px;
      }

      /* ===== 卡片 ===== */
      .card {
        background: var(--color-surface);
        border-radius: 10px;
        border: 1px solid var(--color-border);
        overflow: hidden;
        transition: all 0.3s;
        cursor: pointer;
        flex-shrink: 0;
        text-decoration: none;
        display: block;
      }

      .card:hover {
        transform: translateY(-2px);
        border-color: var(--color-accent);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
      }

      .card-image {
        width: 100%;
        height: 100px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: flex-end;
      }

      .card-pattern {
        position: absolute;
        inset: 0;
        background-image:
          radial-gradient(circle at 20% 30%, rgba(255,255,255,0.12) 0%, transparent 50%),
          radial-gradient(circle at 80% 70%, rgba(255,255,255,0.08) 0%, transparent 50%);
      }

      .card-pattern::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
        background-size: 20px 20px;
      }

      .card-pattern::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -30%;
        width: 120px;
        height: 120px;
        background: rgba(255, 255, 255, 0.06);
        border-radius: 50%;
      }

      .card-image-label {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding: 10px 14px;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
      }

      .card-image-date {
        font-size: 11px;
        color: rgba(255, 255, 255, 0.8);
        font-family: 'JetBrains Mono', monospace;
      }

      .card-image-type {
        font-size: 9px;
        letter-spacing: 1px;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.12);
        padding: 2px 8px;
        border-radius: 4px;
      }

      .card-body { padding: 14px; }

      .card-title {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 5px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        color: var(--color-text);
      }

      .card-desc {
        font-size: 12px;
        color: var(--color-text-secondary);
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 8px;
      }

      .card-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
      }

      .card-tag-inline {
        font-size: 10px;
        color: var(--color-accent);
        opacity: 0.7;
      }

      /* ===== 响应式 ===== */
      @media (max-width: 900px) {
        .home-container { grid-template-columns: 1fr; }
        .sidebar { display: none; }
        .section { min-width: 280px; }
      }
    </style>

    <script is:inline>
      (function() {
        function init() {
          var mc = document.getElementById('mainContent');
          if (!mc) return;

          // 智能滚轮：优先栏目内纵向滚动，到边界后横向切换栏目
          mc.addEventListener('wheel', function(e) {
            // 找鼠标下方的 cards-list（当前聚焦的栏目列表）
            var target = e.target.closest('.cards-list');
            if (target) {
              var atTop = target.scrollTop <= 0;
              var atBottom = target.scrollTop >= target.scrollHeight - target.clientHeight - 1;
              
              // 向上滚且不在顶部 → 让栏目内部滚动
              if (e.deltaY < 0 && !atTop) return;
              // 向下滚且不在底部 → 让栏目内部滚动
              if (e.deltaY > 0 && !atBottom) return;
            }
            
            // 到边界了，横向切换栏目
            e.preventDefault();
            mc.scrollLeft += e.deltaY;
          }, { passive: false, capture: true });

          // 触摸滑动
          var startX = 0;
          var scrollStart = 0;
          mc.addEventListener('touchstart', function(e) {
            startX = e.touches[0].clientX;
            scrollStart = mc.scrollLeft;
          }, { passive: true });

          mc.addEventListener('touchmove', function(e) {
            var dx = startX - e.touches[0].clientX;
            if (Math.abs(dx) > 5) {
              mc.scrollLeft = scrollStart + dx;
            }
          }, { passive: true });
        }

        init();

        // 主题切换
        document.querySelectorAll('.theme-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            var theme = this.getAttribute('data-theme') || 'cosmos';
            document.querySelectorAll('.theme-btn').forEach(function(b) { b.classList.remove('active'); });
            this.classList.add('active');

            if (theme === 'cosmos') {
              document.documentElement.removeAttribute('data-theme');
            } else {
              document.documentElement.setAttribute('data-theme', theme);
            }
            try { localStorage.setItem('theme', theme); } catch (e) {}
          });
        });

        // 初始化主题
        try {
          var saved = localStorage.getItem('theme') || 'cosmos';
          var btn = document.querySelector('.theme-btn[data-theme="' + saved + '"]');
          if (btn) {
            document.querySelectorAll('.theme-btn').forEach(function(b) { b.classList.remove('active'); });
            btn.classList.add('active');
          }
        } catch (e) {}

        // 搜索
        document.getElementById('search-trigger')?.addEventListener('click', function() {
          var event = new KeyboardEvent('keydown', { key: 'k', ctrlKey: true });
          document.dispatchEvent(event);
        });
      })();
    </script>
    <Search />
  </body>
</html>

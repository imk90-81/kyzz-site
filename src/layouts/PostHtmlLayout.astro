---
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  heroImage?: string;
  htmlContent?: string;
  slug?: string;
}

const {
  title,
  description,
  pubDate,
  tags = [],
  heroImage,
  htmlContent,
  slug,
} = Astro.props;

const formattedPubDate = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// 从 HTML 提取 h2/h3 作为 TOC
let tocItems: Array<{ id: string; text: string; level: number }> = [];
let charCount = 0;
let readingTime = 1;

if (htmlContent) {
  // 计算纯文本字符数估算阅读时间
  const textOnly = htmlContent.replace(/<[^>]*>/g, '').trim();
  charCount = textOnly.length;
  readingTime = Math.max(1, Math.ceil(charCount / 300));

  // 提取 h2/h3（自动给没有 id 的标题加 id）
  const idedHtml = htmlContent.replace(/<(h[23])([^>]*)>([\s\S]*?)<\/\1>/gi, function (match, tag, attrs, text) {
    const cleanText = text.replace(/<[^>]*>/g, '').trim();
    if (/id=["'][^"']+["']/i.test(attrs)) return match;
    const id = cleanText.substring(0, 30).replace(/[^\u4e00-\u9fa5a-zA-Z0-9]/g, '-').replace(/-+/g, '-');
    return `<${tag}${attrs} id="${id}">${text}</${tag}>`;
  });
  // 替换回去
  const processedHtml = idedHtml;

  // 提取 TOC
  const headingRegex = /<h([23])[^>]*id=["']([^"']+)["'][^>]*>(.*?)<\/h\1>/gi;
  let m;
  while ((m = headingRegex.exec(processedHtml)) !== null) {
    tocItems.push({
      level: parseInt(m[1]),
      id: m[2],
      text: m[3].replace(/<[^>]*>/g, '').trim(),
    });
  }
}
---

<BaseLayout title={title} description={description} ogImage={heroImage} ogType="article">
  <meta property="article:published_time" content={pubDate.toISOString()} slot="head" />

  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <header class="mb-10 sm:mb-14">
      {heroImage && (
        <div class="mb-8 rounded-xl overflow-hidden border border-space-500/30">
          <img src={heroImage} alt={title} class="w-full h-auto" loading="eager" />
        </div>
      )}

      {tags.length > 0 && (
        <div class="mb-4">
          <TagList tags={tags} />
        </div>
      )}

      <h1 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4 leading-tight">
        {title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 text-sm text-zinc-500">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-cyber-500/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
          </svg>
          <time datetime={pubDate.toISOString()} class="font-mono">
            {formattedPubDate}
          </time>
        </div>

        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-cyber-500/60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="font-mono">{readingTime} 分钟</span>
        </div>
      </div>

      <div class="mt-6 h-px bg-gradient-to-r from-cyber-500/30 via-space-500 to-transparent"></div>
    </header>

    <!-- TOC -->
    {tocItems.length > 0 && (
      <nav class="mb-8 p-4 rounded-lg border" style="background: var(--color-bg-secondary); border-color: var(--color-border);">
        <p class="text-xs font-mono text-zinc-500 mb-2 uppercase tracking-wider">目录</p>
        <ul class="space-y-1">
          {tocItems.map(item => (
            <li style={item.level === 3 ? 'padding-left: 1rem;' : ''}>
              <a
                href={`#${item.id}`}
                class="text-sm text-zinc-400 hover:text-cyber-400 transition-colors"
                style={item.level === 3 ? 'font-size: 0.85em;' : ''}
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- 文章正文 -->
    {htmlContent ? (
      <div class="prose-kyzz" set:html={htmlContent} />
    ) : (
      <slot />
    )}

    <footer class="mt-12 pt-8 border-t border-space-500/50">
      <div class="flex justify-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-cyber-400 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          返回文章列表
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>

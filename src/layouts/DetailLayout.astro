---
import { getCollection } from 'astro:content';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';
import Search from '../components/Search.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Kyzz空间站 - 在技术宇宙中漂浮的前哨站' } = Astro.props;

// 获取栏目数量（用于侧边栏）
const dailyCount = (await getCollection('daily', ({ data }) => !data.draft).catch(() => [])).length;
const blogCount = (await getCollection('blog', ({ data }) => !data.draft).catch(() => [])).length;
const reportCount = (await getCollection('reports', ({ data }) => !data.draft).catch(() => [])).length;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Kyzz空间站</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    <ViewTransitions />
  </head>
  <body>
    <div class="detail-container">
      <!-- 左侧侧边栏（与首页一致） -->
      <aside class="sidebar">
        <div class="sidebar-content">
          <img class="avatar" src="/images/avatar.jpg" alt="头像" />
          <h1 class="site-name">Kyzz空间站</h1>
          <p class="site-tagline">记录思考 · 分享成长</p>

          <nav class="nav-section">
            <div class="nav-title">导航</div>
            <a href="/" class="nav-item">
              <span class="nav-icon">🏠</span>
              <span class="nav-label">首页</span>
            </a>
            <a href="/blog" class={`nav-item${currentPath.startsWith('/blog') ? ' active' : ''}`}>
              <span class="nav-icon">📝</span>
              <span class="nav-label">博客</span>
              <span class="nav-count">{blogCount}</span>
            </a>
            <a href="/daily" class={`nav-item${currentPath.startsWith('/daily') ? ' active' : ''}`}>
              <span class="nav-icon">📰</span>
              <span class="nav-label">Daily</span>
              <span class="nav-count">{dailyCount}</span>
            </a>
            <a href="/reports" class={`nav-item${currentPath.startsWith('/reports') ? ' active' : ''}`}>
              <span class="nav-icon">📊</span>
              <span class="nav-label">Reports</span>
              <span class="nav-count">{reportCount}</span>
            </a>
            <button id="search-trigger-detail" class="nav-item">
              <span class="nav-icon">🔍</span>
              <span class="nav-label">搜索</span>
            </button>
          </nav>

          <div class="theme-switcher">
            <button class="theme-btn active" data-theme="cosmos" title="宇宙">🌌</button>
            <button class="theme-btn" data-theme="day" title="白昼">☀️</button>
            <button class="theme-btn" data-theme="nebula" title="星云">🌠</button>
          </div>

          <div class="social-links">
            <a href="mailto:" class="social-link" title="邮箱">📧</a>
            <a href="https://github.com" target="_blank" class="social-link" title="GitHub">🐙</a>
          </div>
        </div>
      </aside>

      <!-- 右侧文章内容 -->
      <main class="main-content">
        <div class="article-wrapper">
          <slot />
        </div>
      </main>
    </div>

    <!-- AI 提示栏 -->
    <div class="ai-disclaimer-bar">
      <div class="ai-disclaimer-inner">
        <span class="ai-emoji">🤖</span>
        <span>本站所有内容均为 <span class="ai-highlight">AI 生成</span>，仅供参考</span>
      </div>
    </div>

    <style>
      /* ===== 容器 ===== */
      .detail-container {
        display: grid;
        grid-template-columns: 220px 1fr;
        min-height: 100vh;
        background: var(--color-bg);
      }

      /* ===== 侧边栏 ===== */
      .sidebar {
        position: sticky;
        top: 0;
        height: 100vh;
        overflow-y: auto;
        border-right: 1px solid var(--color-border);
        background: var(--color-bg-secondary);
        padding: 24px 12px;
        display: flex;
        flex-direction: column;
      }

      .sidebar-content {
        display: flex;
        flex-direction: column;
        height: 100%;
      }

      .avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 14px;
      }

      .site-name {
        font-size: 18px;
        font-weight: 700;
        color: var(--color-text);
        margin-bottom: 4px;
      }

      .site-tagline {
        font-size: 12px;
        color: var(--color-text-secondary);
        text-align: left;
        margin-bottom: 20px;
      }

      .nav-section { margin-bottom: 16px; }

      .nav-title {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: var(--color-text-secondary);
        margin-bottom: 8px;
        padding-left: 10px;
        opacity: 0.6;
      }

      .nav-item {
        display: flex;
        align-items: center;
        padding: 9px 12px;
        border-radius: 8px;
        margin-bottom: 2px;
        cursor: pointer;
        transition: all 0.2s;
        color: var(--color-text-secondary);
        text-decoration: none;
        border: none;
        background: none;
        width: 100%;
        font-size: 13px;
        font-family: inherit;
      }

      .nav-item:hover { background: var(--color-border); color: var(--color-text); }

      .nav-item.active {
        background: linear-gradient(135deg, rgba(0, 229, 255, 0.08), rgba(99, 102, 241, 0.08));
        color: var(--color-accent);
      }

      .nav-icon { width: 18px; margin-right: 10px; font-size: 15px; }
      .nav-label { flex: 1; }

      .nav-count {
        font-size: 10px;
        background: var(--color-border);
        padding: 1px 7px;
        border-radius: 10px;
        color: var(--color-text-secondary);
      }

      .theme-switcher {
        display: flex;
        gap: 4px;
        padding: 6px;
        background: var(--color-border);
        border-radius: 8px;
        margin-top: auto;
      }

      .theme-btn {
        flex: 1;
        padding: 4px 6px;
        border-radius: 5px;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 16px;
        text-align: center;
      }

      .theme-btn:hover { background: rgba(255, 255, 255, 0.05); }

      .theme-btn.active {
        background: linear-gradient(135deg, rgba(0, 229, 255, 0.15), rgba(99, 102, 241, 0.15));
        box-shadow: 0 0 8px rgba(0, 229, 255, 0.2);
      }

      .social-links {
        display: flex;
        gap: 8px;
        margin-top: 14px;
        justify-content: center;
      }

      .social-link {
        font-size: 16px;
        opacity: 0.5;
        transition: opacity 0.2s;
        text-decoration: none;
      }

      .social-link:hover { opacity: 1; }

      /* ===== 右侧主内容 ===== */
      .main-content {
        flex: 1;
        min-height: 100vh;
        padding-bottom: 40px;
      }

      .article-wrapper {
        max-width: 800px;
        margin: 0 auto;
      }

      /* ===== AI 提示栏 ===== */
      .ai-disclaimer-bar {
        position: fixed;
        bottom: 0;
        left: 220px;
        right: 0;
        z-index: 40;
        border-top: 1px solid var(--color-border);
        background: color-mix(in srgb, var(--color-bg) 95%, transparent);
        backdrop-filter: blur(8px);
      }

      .ai-disclaimer-inner {
        max-width: 800px;
        margin: 0 auto;
        padding: 8px 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 12px;
        color: var(--color-text-secondary);
      }

      .ai-emoji { font-size: 14px; }
      .ai-highlight { font-weight: 500; color: var(--color-accent); }

      /* ===== 响应式 ===== */
      @media (max-width: 900px) {
        .detail-container { grid-template-columns: 1fr; }
        .sidebar { display: none; }
        .ai-disclaimer-bar { left: 0; }
        .article-wrapper { padding: 0 16px; }
      }
    </style>

    <script>
      // 主题切换
      document.querySelectorAll('.theme-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var theme = this.getAttribute('data-theme') || 'cosmos';
          document.querySelectorAll('.theme-btn').forEach(function(b) { b.classList.remove('active'); });
          this.classList.add('active');

          if (theme === 'cosmos') {
            document.documentElement.removeAttribute('data-theme');
          } else {
            document.documentElement.setAttribute('data-theme', theme);
          }
          try { localStorage.setItem('theme', theme); } catch (e) {}
        });
      });

      // 初始化主题
      try {
        var saved = localStorage.getItem('theme') || 'cosmos';
        var btn = document.querySelector('.theme-btn[data-theme="' + saved + '"]');
        if (btn) {
          document.querySelectorAll('.theme-btn').forEach(function(b) { b.classList.remove('active'); });
          btn.classList.add('active');
        }
      } catch (e) {}

      // 搜索触发
      document.getElementById('search-trigger-detail')?.addEventListener('click', function() {
        var event = new KeyboardEvent('keydown', { key: 'k', ctrlKey: true });
        document.dispatchEvent(event);
      });
    </script>
    <Search />
  </body>
</html>
